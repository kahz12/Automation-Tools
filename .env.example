# Automation-Tools — AI provider configuration
#
# Copy this file to .env and fill in only the providers you actually use.
# .env is gitignored; this example is not, so never put a real key here.
#
# Pick the default provider. Every AI tool also takes --provider to override it
# per run, and the TUI has a dropdown. Unset means gemini, which is how the
# project behaved before multi-provider support.
# AI_PROVIDER=gemini

# One key per provider. The capabilities after each name are what that provider
# can be selected for; tools filter the list, so a provider that cannot do the
# job is never offered.

# Text · Vision · Audio
GOOGLE_API_KEY=
# Text · Vision · Audio
OPENAI_API_KEY=
# Text · Vision · Audio
GROQ_API_KEY=
# Text · Vision
ANTHROPIC_API_KEY=
# Text · Vision  (xAI / Grok)
XAI_API_KEY=
# Text · Vision  (Qwen / Alibaba DashScope)
DASHSCOPE_API_KEY=
# Text · Vision
MINIMAX_API_KEY=
# Text only — DeepSeek has no vision or audio model
DEEPSEEK_API_KEY=
